# QA local — Playwright (Fase A)
# Copiar a frontend/.env.test.local (gitignored). NUNCA apuntar a servicios reales.

NEXT_PUBLIC_SUPABASE_URL_LOCAL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY_LOCAL=
NEXT_PUBLIC_BACKEND_URL_LOCAL=http://localhost:8000

PLAYWRIGHT_BASE_URL=http://localhost:3000

QA_TEST_USER_EMAIL=qa.e2e@local.test
QA_TEST_USER_PASSWORD=

# Usuario dedicado para el test de logout (signOut() revoca todos los
# refresh tokens del usuario — no debe ser el mismo que QA_TEST_USER_*)
QA_LOGOUT_USER_EMAIL=qa.logout@local.test
QA_LOGOUT_USER_PASSWORD=

# Backend (solo si el backend local lee estas vars de entorno propio)
WSFE_ADAPTER_MODE=stub
MERCADOPAGO_MODE=sandbox
