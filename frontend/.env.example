# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Python Backend — FastAPI (required)
# URL del backend FastAPI (ej: https://tu-backend.onrender.com)
# El frontend fallara al iniciar si esta variable no esta definida.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000


# Landing — contacto por WhatsApp (opcional)
# Numero de WhatsApp de ALIADATA al que apunta el boton flotante de la home (/).
# Formatos aceptados: +54 9 261 555-1234, 0261 555-1234, 5492615551234.
# Es una variable de SERVIDOR (sin NEXT_PUBLIC_): la lee app/page.tsx y se la
# pasa al componente. Si falta o el numero no es valido, el boton simplemente
# no se renderiza y la landing queda igual — nunca se publica un link roto.
# Ojo: en Vercel, editar la variable no afecta a los deploys existentes; hace
# falta un Redeploy para que tome efecto.
ALIADATA_WHATSAPP_PHONE="+54 9 261 555-1234"
