# ── Auth: verificacion del JWT ───────────────────────────────────────────
# SUPABASE_URL es la variable que ELIGE la rama de verificacion.
#   presente y https:// -> JWKS (ES256/RS256). Es lo que corre en produccion.
#   ausente             -> secreto compartido HS256, solo dev/CI, y SOLO con
#                          la palanca de abajo encendida.
#
# El backend NO LEVANTA si esta ausente (o no es https://) y la palanca esta
# apagada. Es deliberado: sin este chequeo, un SUPABASE_URL mal puesto en el
# deploy caia en silencio a HS256 con el secreto por default, que acepta
# tokens forjados -- impersonacion completa, no una degradacion visible.
#
# CUIDADO CON LA BARRA FINAL: el valor va sin "/" al final. Hoy una barra de
# mas es invisible (la URL de JWKS la tolera); con la verificacion de emisor
# puesta convertiria el issuer esperado en ".../supabase.co//auth/v1" y daria
# 401 al 100% del trafico. El codigo la normaliza igual, pero el valor
# correcto es sin barra.
SUPABASE_URL=https://<project-ref>.supabase.co

# Salida documentada para correr en local SIN JWKS (uvicorn, pytest).
# Dejarla en "true" en un deploy real es exactamente el estado que el
# chequeo de arranque existe para impedir.
AUTH_ALLOW_HS256_FALLBACK=false

# Supabase JWT secret (Settings > API > JWT Secret) -- solo rama HS256
SUPABASE_JWT_SECRET=

# PostgreSQL -- usar el pooler de Supabase (puerto 6543, no 5432)
# postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Upstash Redis
# redis://default:[password]@[host].upstash.io:6379
REDIS_URL=

# Entorno de ejecucion. APP_ENV es LOAD-BEARING desde auth-hardening-jwt-cookies
# (D10): con "production" el comodin de CORS esta prohibido (el arranque falla) y
# http://localhost:3000 NO queda admitido. En un deploy real va "production".
APP_ENV=development
# Backend URL (exposed to Next.js frontend)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# CORS: dejala SIN DEFINIR. Los origenes reales ya estan en la allow-list de
# backend/core/cors.py (dominio de produccion con y sin www, previews de Vercel,
# y localhost fuera de produccion). Sirve solo para sumar UN origen concreto
# extra desde el entorno; "*" esta PROHIBIDO con APP_ENV=production y aborta el
# arranque, y fuera de produccion se ignora (nunca entra a la lista).
# BACKEND_ALLOWED_ORIGIN=

SUPABASE_SERVICE_ROLE_KEY=

MERCADOPAGO_WEBHOOK_SECRET=

MERCADOPAGO_ACCESS_TOKEN=